# myTrakIn web app. Local: copy to .env.local. Vercel: Project → Settings → Environment Variables.
# Everything here is public (sent to the browser) — never put secrets in NEXT_PUBLIC_ variables.

NEXT_PUBLIC_API_URL=http://localhost:8000          # the FastAPI deployment, e.g. https://api.mytrakin.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                       # Supabase → Project Settings → API → anon / publishable key
