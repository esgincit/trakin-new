# ---------------------------------------------------------------------------
# myTrakIn API — environment variables
# Local: copy to .env.   Vercel: Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

ENVIRONMENT=development                # development | staging | production

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
# Use the pooler for Vercel; the direct connection (5432) is only for migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL=none                           # none on Vercel (serverless); queue for a long-running server

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=                   # only for projects still on the legacy JWT secret; leave empty for signing keys (JWKS)
SUPABASE_SERVICE_ROLE_KEY=             # server only — file storage. NEVER put this in the web app.

# The web app's address (CORS and links in e-mails). Add preview domains comma-separated.
WEB_ORIGIN=http://localhost:3000
EXTRA_CORS_ORIGINS=

# E-mail: Resend API first, plain SMTP (e.g. Zoho) as fallback.
# Empty = e-mails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=myTrakIn <no-reply@yourdomain.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: plain-English answers on top of smart suggestions (Anthropic or DeepSeek)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_PROVIDER=anthropic                        # anthropic | deepseek
DEEPSEEK_API_KEY=                            # https://platform.deepseek.com/api_keys
DEEPSEEK_MODEL=deepseek-chat                 # or deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Security
REQUIRE_MFA_FOR_MONEY_ROLES=true       # admins and finance must use two-step verification
SIGNING_LINK_DAYS=30
